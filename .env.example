# Opportunity Command Center / phill-job-application-copilot
# Copy to .env locally. Never commit .env. Use GitHub Secrets in production.

# --- Cloudflare / deployment ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
PROJECT_DOMAIN=

# --- Supabase / database ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_DB_PASSWORD=

# --- Frontend-safe Vite variables (no secrets) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_PROJECT_DOMAIN=

# --- AI models ---
GEMINI_API_KEY=
GROQ_API_KEY=
HF_TOKEN=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434

# --- Scraping / discovery ---
FIRECRAWL_API_KEY=
SCRAPINGBEE_API_KEY=
APIFY_API_TOKEN=
TAVILY_API_KEY=

# --- Pipeline tuning (optional) ---
SCRAPER_SCHEDULE=0 7 * * *
AI_DAILY_CLOUD_CALL_LIMIT=200
DISCOVERY_MAX_TERMS=12
SCRAPE_MAX_URLS=15
CHROMA_PERSIST_DIR=./data/chroma
LOG_LEVEL=INFO
OLLAMA_ENABLED=false
